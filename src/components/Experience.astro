---
import { experience, education, skills } from '../data/profile';
const marquee = skills.flatMap((g) => g.items);
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track mono">
    {[...marquee, ...marquee].map((s) => <span>{s}<i>/</i></span>)}
  </div>
</div>

<section id="experience" class="section" aria-labelledby="exp-title">
  <div class="wrap exp">
    <div class="exp__aside">
      <p class="eyebrow">Experience</p>
      <h2 id="exp-title" class="h2" data-reveal>From racking servers to shipping portals.</h2>
      <p class="lede" data-reveal>
        Three years of ops gave me the context. Now I build the tools.
      </p>
      <a class="btn exp__resume" href="/resume">Printable resume <span aria-hidden="true">→</span></a>
    </div>

    <ol class="timeline">
      {
        experience.map((r, i) => (
          <li class="role" data-reveal style={`--i:${i}`} data-current={i === 0}>
            <div class="role__meta mono">
              <span>{r.period}</span>
              <span>{r.org}</span>
            </div>
            <h3 class="role__title">{r.title}</h3>
            <ul class="role__list">
              {r.highlights.map((h) => <li>{h}</li>)}
            </ul>
            <div class="role__stack">
              {r.stack.map((s) => <span class="chip">{s}</span>)}
            </div>
          </li>
        ))
      }
      <li class="role role--edu" data-reveal>
        <div class="role__meta mono">
          <span>{education.period}</span>
          <span>{education.school}</span>
        </div>
        <h3 class="role__title">{education.degree}</h3>
      </li>
    </ol>
  </div>

  <div class="wrap">
    <div class="skills">
      {
        skills.map((g, i) => (
          <div class="skills__group" data-reveal style={`--i:${i}`}>
            <h3 class="mono">{g.name}</h3>
            <ul>
              {g.items.map((s) => <li>{s}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .marquee {
    border-block: 1px solid var(--line);
    overflow: hidden;
    padding-block: 1.1rem;
    background: var(--ink-2);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marquee 50s linear infinite;
    font-size: clamp(1rem, 2vw, 1.35rem);
    color: var(--muted);
  }
  .marquee__track span {
    padding-right: 1.5rem;
    white-space: nowrap;
  }
  .marquee__track i {
    color: var(--signal);
    font-style: normal;
    padding-left: 1.5rem;
  }
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .exp {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }
  .exp__aside {
    position: sticky;
    top: 6rem;
  }
  .exp__resume {
    margin-top: 2rem;
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 1.75rem;
    border-left: 1px solid var(--line);
  }
  .role {
    position: relative;
    padding-bottom: 2.75rem;
  }
  .role::before {
    content: '';
    position: absolute;
    left: calc(-1.75rem - 6px);
    top: 0.35rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--ink);
    border: 2px solid var(--muted);
  }
  .role[data-current='true']::before {
    background: var(--signal);
    border-color: var(--signal);
    box-shadow: 0 0 0 5px rgb(198 244 50 / 0.18);
  }
  .role__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .role[data-current='true'] .role__meta span:first-child {
    color: var(--signal);
  }
  .role__title {
    font-size: clamp(1.3rem, 2.4vw, 1.65rem);
    letter-spacing: -0.02em;
    margin: 0.35rem 0 0.9rem;
    line-height: 1.2;
  }
  .role__list {
    margin: 0 0 1rem;
    padding-left: 1.1rem;
    color: var(--muted);
  }
  .role__list li {
    margin-bottom: 0.45rem;
  }
  .role__list li::marker {
    color: var(--signal);
  }
  .role__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .role--edu {
    padding-bottom: 0;
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    margin-top: 4rem;
  }
  .skills__group {
    background: var(--ink);
    padding: 1.25rem;
  }
  .skills__group h3 {
    font-size: 0.78rem;
    color: var(--signal);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 0.8rem;
    font-weight: 500;
  }
  .skills__group ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }

  @media (max-width: 960px) {
    .exp {
      grid-template-columns: 1fr;
    }
    .exp__aside {
      position: static;
    }
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .skills {
      grid-template-columns: 1fr;
    }
  }
</style>
